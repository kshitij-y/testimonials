generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Replace with "mysql" or "sqlite" if using those
  url      = env("DATABASE_URL") // Ensure your .env file has the DATABASE_URL
}
model User {
  id           String      @id @default(uuid())
  email        String   @unique
  passwordHash String?  
  googleId     String?  @unique
  name         String?
  avatarUrl    String?  
  Spaces       Space[]
}

model Space {
  id          String       @id @default(uuid())
  userId      String
  name        String
  description String
  logoUrl     String
  title       String
  Questions   String[]
  thankGif    String
  thankTitle  String
  thankMsg    String
  redirectUrl String?
  testimonial Testimonial[]

  user User @relation(fields: [userId], references: [id])
}

model Testimonial {
  id        String      @id @default(uuid())
  spaceId   String
  name      String
  email     String
  content   String
  videoUrl  String?
  rating    Int
  show      Boolean
  space     Space   @relation(fields: [spaceId], references: [id])
}